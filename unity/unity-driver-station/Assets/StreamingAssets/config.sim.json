{
  "_comment": "Sim-mode preset. To enable: copy this file over config.json, or set sim.enabled=true in the real one. In sim mode the driver-station bypasses the UDP/TCP pipes and drives an in-engine car on a procedural Novi-inspired track. Great for demos without hardware and for iterating on the driver-assist system.",
  "network": {
    "jetsonIp": "10.0.0.50",
    "controlPort": 7411,
    "telemetryPort": 7412,
    "sendHz": 200
  },
  "video": {
    "bridgeHost": "127.0.0.1",
    "cam0Port": 9000,
    "cam1Port": 9001,
    "texWidth": 1280,
    "texHeight": 720
  },
  "wheel": {
    "steeringAxis": 1,
    "throttleAxis": 6,
    "brakeAxis": 5,
    "steeringDeadzone": 0.08,
    "triggersAreBiPolar": true,
    "invertSteering": false,
    "btnArm": 0,
    "btnDisarm": 1,
    "btnEstop": 2,
    "btnReset": 3,
    "btnToggleCam": 4,
    "btnLapMark": 5,
    "logDiscovery": false
  },
  "race": {
    "targetLapCount": 5,
    "minLapSeconds": 10.0,
    "autoLapFromButton": true,
    "driverName": "Sim Driver",
    "trackName": "Novi — Main Loop (sim)"
  },
  "hud": {
    "showTelemetryOverlay": true,
    "showInputsOverlay": true,
    "showRaceHud": true,
    "hudAlpha": 0.85
  },
  "audio": {
    "engineSoundEnabled": true,
    "masterVolume": 0.7,
    "engineMinHz": 80.0,
    "engineMaxHz": 420.0
  },
  "sim": {
    "enabled": true,
    "straightSpeedMps": 13.5,
    "accelMps2": 9.0,
    "brakeMps2": 18.0,
    "maxSteerDeg": 35.0,
    "wheelbaseM": 0.33,
    "gripN": 35.0,
    "drag": 1.2,
    "trackWidthM": 4.0,
    "trackName": "Novi — Main Loop (sim)"
  },
  "assists": {
    "defaultLevel": 1,
    "disabled": false
  }
}
