[Unit]
Description=rcpilot dual-camera real panorama sender (IMX219 x2 -> warped/blended RTP H.264 -> cockpit)
Documentation=https://github.com/pramodaravi/rcpilot
After=network-online.target
Wants=network-online.target
# Wait for the v4l2 device tree entry to settle before the GStreamer pipeline
# tries to open it. Without this, on cold boot start_video.sh sometimes races
# the camera initialization and fails with 'Could not open device /dev/video0'.
After=systemd-udev-settle.service
# Cap restart spam so we don't peg the CPU if the camera is permanently dead.
# Modern systemd requires these in [Unit], not [Service].
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=adm2n
Group=adm2n
WorkingDirectory=/home/adm2n/rcpilot
# Cockpit IP for the Wi-Fi bench bring-up (Starlink subnet). If the cockpit
# machine ever takes a different DHCP lease, override with a drop-in:
#   sudo systemctl edit rcpilot-video.service
#   [Service]
#   Environment=RCPILOT_COCKPIT_IP=<new-cockpit-ip>
# The previous USB-C cockpit IP was 192.168.55.100; switch back via a drop-in
# if the Wi-Fi link is unavailable for a session.
Environment=RCPILOT_COCKPIT_IP=192.168.1.247
ExecStart=/usr/bin/bash /home/adm2n/rcpilot/scripts/jetson/start_video_stitched.sh
# Restart only on actual process failure. The current Python stitcher exits
# non-zero for camera/open/calibration failures, and exits cleanly on SIGTERM
# so manual testing with `systemctl stop rcpilot-video` or `pkill` does not
# immediately respawn a second camera owner.
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
