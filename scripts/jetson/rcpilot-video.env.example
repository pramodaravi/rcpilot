# rcpilot-video systemd EnvironmentFile.
#
# Installed to /etc/default/rcpilot-video by install_services.sh. Edit this
# file (NOT the .service unit) to change runtime knobs. Take effect after:
#
#   sudo systemctl restart rcpilot-video
#
# Lines beginning with `#` are comments. systemd EnvironmentFile syntax is
# strict KEY=value, no shell expansion, no `export` keyword.
#
# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Cockpit IP this Jetson sends RTP video to. Default in the unit file is
# 192.168.1.247 (Starlink subnet). Uncomment to override on a different LAN.
#RCPILOT_COCKPIT_IP=192.168.1.247

# UDP port for video. Cockpit-side bridge.py listens on this port. Match
# Config.video.cam0Port in the Unity build.
#RCPILOT_VIDEO_PORT=5004

# Sender mode. Default is stitch: one warped/blended panorama over UDP 5004.
# Use native-sbs only for rescue/debug if you need to prove both cameras are
# alive without the feature-alignment path.
RCPILOT_VIDEO_MODE=stitch

# ---------------------------------------------------------------------------
# Stitch acceleration
# ---------------------------------------------------------------------------

# Per-frame remap backend. The Jetson default is VPI CUDA remap.
#   vpi          — fastest on JetPack 6.2 stock cv2 (~4.5 ms/frame, 1280x720→2560x720)
#   opencv-cuda  — needs custom-built cv2 with CUDA; not the JetPack default
#   cpu          — pure cv2.remap; ~17 ms/frame, the fallback when GPU paths fail
#   auto         — try in priority order
RCPILOT_STITCH_ACCEL=vpi

# Static seam crossfade width in pixels. Lower values reduce ghosting from
# foreground parallax; 0 is a hard seam. The code default is 4.
#RCPILOT_STITCH_FEATHER_PX=4

# H.264 encoder.
#   x264enc        — software, the only working choice on Orin Nano (NVENC missing)
#   nvv4l2h264enc  — hardware NVENC, available on Orin NX and AGX (NOT Orin Nano)
# When the Orin NX module is installed, flip this to nvv4l2h264enc.
#RCPILOT_ENCODER=x264enc

# ---------------------------------------------------------------------------
# Foreground-segmentation seam (v0.3)
# ---------------------------------------------------------------------------

# Foreground snap is now opt-in because it can smear or shimmer when the
# disagreement is calibration/exposure instead of true foreground motion.
# Enable it only after comparing diagnostic_stitched_no_fg_snap.jpg and
# diagnostic_stitched_fg_snap.jpg from RCPILOT_STITCH_DIAGNOSTIC=1.
#RCPILOT_STITCH_FG_SNAP=0

# Picks how the stitcher detects parallax-affected pixels (e.g. a hand
# reaching into the cockpit) and snaps the seam to one camera there
# instead of feather-blending both. Without this, hands "ghost" in the
# overlap region.
#
# Providers (see scripts/jetson/seg_seam.py):
#   absdiff  — DEFAULT. Luma-diff between warped left/right; no ML required.
#              Misses hands when hand and background have similar luma.
#   skin     — HSV skin-tone heuristic. No ML, but only catches skin-colored
#              foreground objects. Useful for validating the wiring works.
#   yolo26   — Ultralytics YOLO26-seg via TensorRT. Real semantic
#              segmentation; AGPL-3.0 license — fine for development, NOT
#              for paid deployment without an Ultralytics enterprise
#              license. Requires `pip install ultralytics` AND
#              RCPILOT_STITCH_YOLO_ENGINE pointing at a .engine or .pt
#              file.
#   off      — disable seam-snap. Seam reverts to baked feather (will ghost
#              hands). Useful for A/B comparison.
#
# When unset, the stitcher uses the legacy hardcoded absdiff path
# (bit-identical to v0.2 behavior). Set this var explicitly to opt into
# the v0.3 pluggable path, even for absdiff.
#RCPILOT_STITCH_SEG=

# YOLO26-only knobs. Ignored for other providers.
#RCPILOT_STITCH_YOLO_ENGINE=/home/adm2n/rcpilot/models/yolo26n_seg_int8.engine
#RCPILOT_STITCH_YOLO_CLASSES=person
#RCPILOT_STITCH_YOLO_CONF=0.30
#RCPILOT_STITCH_YOLO_IMGSZ=640
#RCPILOT_STITCH_YOLO_EVERY_N=3
#RCPILOT_STITCH_YOLO_DILATE_PX=4
#RCPILOT_STITCH_YOLO_SOURCE=left

# Skin-color provider tunables (HSV range, dilation, cadence, min area).
#RCPILOT_STITCH_SKIN_HMIN=0
#RCPILOT_STITCH_SKIN_HMAX=25
#RCPILOT_STITCH_SKIN_SMIN=40
#RCPILOT_STITCH_SKIN_SMAX=200
#RCPILOT_STITCH_SKIN_VMIN=60
#RCPILOT_STITCH_SKIN_VMAX=255
#RCPILOT_STITCH_SKIN_SOURCE=left
#RCPILOT_STITCH_SKIN_DILATE_PX=8
#RCPILOT_STITCH_SKIN_EVERY_N=5
#RCPILOT_STITCH_SKIN_MIN_AREA=800

# Absdiff provider tunables (legacy fg-snap parameters, exposed via the
# new pluggable path).
#RCPILOT_STITCH_ABSDIFF_THRESHOLD=30
#RCPILOT_STITCH_ABSDIFF_DILATE_PX=6
#RCPILOT_STITCH_ABSDIFF_EVERY_N=10

# ---------------------------------------------------------------------------
# Calibration / startup
# ---------------------------------------------------------------------------

# Force re-running feature-based stitch alignment on next start instead of
# loading the cached homography. Set to 1 if cameras moved.
#RCPILOT_STITCH_RECALIBRATE=0

# Calibration file location. Default works for the standard install.
#RCPILOT_STITCH_CALIBRATION=/home/adm2n/rcpilot/config/stitch_calibration.json
